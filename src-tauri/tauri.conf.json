{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APD AI Roundtable Workbench",
  "version": "0.1.0",
  "identifier": "com.apd.ai-roundtable-workbench",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APD AI Roundtable Workbench",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": null,
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "sidebarImage": null
      }
    }
  }
}
