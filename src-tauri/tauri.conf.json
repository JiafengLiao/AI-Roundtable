{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI小圆桌",
  "version": "0.1.0",
  "identifier": "com.ai.roundtable",
  "build": {
    "beforeDevCommand": "node scripts/run-npm.mjs dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/run-npm.mjs build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI小圆桌",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "maximized": true,
        "windowClassname": "ai-roundtable-main-window",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/16x16.png",
      "icons/20x20.png",
      "icons/24x24.png",
      "icons/30x30.png",
      "icons/32x32.png",
      "icons/36x36.png",
      "icons/40x40.png",
      "icons/44x44.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/96x96.png",
      "icons/128x128.png",
      "icons/150x150.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": null,
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "sidebarImage": null
      }
    }
  }
}
